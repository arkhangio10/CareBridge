# OpenAI
OPENAI_API_KEY=sk-...

# Databricks
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_CATALOG=virtueconnect
DATABRICKS_SCHEMA=gold

# Databricks Vector Search
DATABRICKS_VS_ENDPOINT=virtueconnect_vs_endpoint
DATABRICKS_VS_INDEX=virtueconnect.gold.facility_chunks_index

# MLflow
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/Users/<user>/virtueconnect

# Geocoding (optional – Nominatim is free, Google requires key)
GOOGLE_MAPS_API_KEY=

# App
CSV_PATH=data/Virtue Foundation Ghana v0.3 - Sheet1.csv
